# =============================================
# Configuração local do projeto Toten
# =============================================
# Copie este arquivo para .env.local e preencha os valores

# Banco de dados PostgreSQL (Neon)
# Obtenha em: https://console.neon.tech
DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Chave secreta para o Better Auth
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=sua_chave_secreta_aqui

# URL base da aplicação (deixe em branco para autodetectar na Vercel)
# BETTER_AUTH_URL=https://totenbr.vercel.app
